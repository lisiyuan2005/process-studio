{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // "node" is for the tests, which read styles.css and tauri.conf.json to
    // check the layout cannot outgrow the window; nothing the browser runs
    // imports from node.
    "types": ["vite/client", "node"]
  },
  "include": ["src"]
}
