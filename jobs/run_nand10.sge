#!/bin/bash
# 用法：qsub -v GRID=2 jobs/run_nand10.sge
#$ -N np3d_nand10
#$ -q long
#$ -pe smp 8
#$ -o /users/sli52/Nowprocess3D/jobs/logs/
#$ -j y
set -eo pipefail
source /software/Modules/5.6.1/init/bash
module load python/3.12.15
cd /users/sli52/Nowprocess3D
source .venv/bin/activate
pip install -q -e . fast-simplification
export OMP_NUM_THREADS=$NSLOTS
GRID=${GRID:-2}
OUT=runs/nand10_g${GRID}_${JOB_ID}
/usr/bin/time -v process3d run examples/nand10/recipe.yaml --out "$OUT" --grid "$GRID" 2> >(tee "jobs/logs/time_${JOB_ID}.txt" >&2)
echo "RUN_DIR=$OUT"
