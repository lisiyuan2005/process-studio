#!/bin/bash
#$ -N np3d_lsvoxbuild
#$ -q long
#$ -pe smp 4
#$ -o /users/sli52/Nowprocess3D/jobs/logs/
#$ -j y
set -eo pipefail
source /software/Modules/5.6.1/init/bash
module load python/3.12.15
cd /users/sli52/Nowprocess3D
source .venv/bin/activate
pip install -q nanobind cmake ninja
rm -rf cpp/lsvox/build
cmake -S cpp/lsvox -B cpp/lsvox/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DPython_EXECUTABLE=$(which python)
cmake --build cpp/lsvox/build -j $NSLOTS 2>&1 | grep -E "error|Error|warning: unused" | head -40 || true
cp cpp/lsvox/build/_lsvox*.so src/nowprocess3d/backends/
python -c "from nowprocess3d.backends import _lsvox; print('lsvox OK')"
echo BUILD_OK
